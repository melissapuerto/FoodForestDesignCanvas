#!/bin/sh
# Every commit names the PemaSE guideline it advances (MAINTENANCE.md §Reading
# the git history). Merge/revert/fixup commits are exempt.
msg_file="$1"
first_line=$(head -n 1 "$msg_file")
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if ! grep -qE '^Guideline: .+ — PemaSE$' "$msg_file"; then
  echo "" >&2
  echo "commit-msg: missing guideline trailer." >&2
  echo "Every commit ends with a line like:" >&2
  echo "" >&2
  echo "  Guideline: Use Small and Slow Solutions — PemaSE" >&2
  echo "" >&2
  echo "See MAINTENANCE.md for the guideline list." >&2
  exit 1
fi
