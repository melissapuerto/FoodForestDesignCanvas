# Frontend build-time env. Vite bakes these into the bundle at build,
# so changes require a rebuild.

# Backend base URL.
# Local dev:  http://localhost:8000
# Docker dev: http://localhost:8000  (host-side; the container talks via service name)
# Production: https://kuxtal-api.onrender.com
VITE_API_URL=http://localhost:8000
