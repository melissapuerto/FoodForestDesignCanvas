{
  "name": "kuxtal-app",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Kuxtal — offline-first land/plant management PWA",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:engine": "esbuild scripts/engine-smoke.ts --bundle --platform=node --format=esm --outfile=scripts/.smoke.mjs && node scripts/.smoke.mjs",
    "budget": "node scripts/budget.mjs",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.4",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.9",
    "workbox-window": "^7.3.0"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.49.1-build1",
    "chart.js": "^4.4.7",
    "dexie": "^4.0.10",
    "driver.js": "^1.3.6",
    "maplibre-gl": "^5.0.0",
    "rbush": "^4.0.1"
  }
}
